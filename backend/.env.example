PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/symptomlog
JWT_SECRET=__REPLACE_ME__run_node_-e_"console.log(require('crypto').randomBytes(48).toString('hex'))"
ML_SERVICE_URL=http://localhost:8001
NODE_ENV=development

# Structured logging (OBS-1). One of: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

# SEC-17: demo/seed accounts (admins, doctors, patients + sample data) are
# only ever created when this is explicitly "true". Never set this in a
# production environment — the seeded passwords are intentionally simple.
SEED_DEMO=false

# Security hardening (JWT refresh rotation + CORS allowlist)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set to true only once served over HTTPS in production
COOKIE_SECURE=false
# SEC-14: Content-Security-Policy is on by default for this process's own
# responses (API JSON + the /api/docs Swagger UI). Set to "false" only as
# an escape hatch if it breaks something unexpectedly.
ENABLE_CSP=true

# Web Push (medicine alarms that fire even with the browser tab closed/backgrounded)
# Generate your own pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=__REPLACE_ME__
VAPID_PRIVATE_KEY=__REPLACE_ME__
VAPID_SUBJECT=mailto:admin@symptomlog.local
